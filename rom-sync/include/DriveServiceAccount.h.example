// Copy this file to DriveServiceAccount.h (gitignored) and fill in the
// fields from your service account's downloaded JSON key (Google Cloud
// Console -> IAM & Admin -> Service Accounts -> Keys).
//
// This is the SAME service account save-sync/checkpoint uses - if you
// already set one up for save-sync, just copy its
// save-sync/checkpoint/3ds/include/DriveServiceAccount.hpp here instead of
// creating a new one (the file format is identical, only the extension
// differs).
//
// Remember: a service account has no access to your Drive by default. Share
// whatever folders/files you want to sync with its client email address
// first (Drive web UI -> right-click -> Share).
#pragma once

#define DRIVE_SA_CLIENT_EMAIL "YOUR_SERVICE_ACCOUNT@YOUR_PROJECT.iam.gserviceaccount.com"
#define DRIVE_SA_TOKEN_URI "https://oauth2.googleapis.com/token"
// The "private_key" field's value, verbatim (keep the literal \n escapes -
// PEM parsers expect real newlines, which these \n's become once the C
// compiler unescapes this string literal).
#define DRIVE_SA_PRIVATE_KEY_PEM "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
